VITE_API_URL="http://127.0.0.1:8000/"

# Docker base images for `docker compose build` (see docker-compose.yml build.args).
# docker-compose defaults to AWS Public ECR mirrors (same official Node/Nginx images).
# Uncomment to force Docker Hub instead (only if your network resolves auth.docker.io):
# DOCKER_NODE_IMAGE=node:18-alpine
# DOCKER_NGINX_IMAGE=nginx:alpine
