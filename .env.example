# LAN: URL the browser uses for the Django API (nginx → backend). Trailing slash optional; stripped at runtime.
# Match backend compose nginx publish (e.g. 8092:80), not the SPA port (often 3000).
VITE_API_URL=http://192.168.1.4:8092

# Internal portal dashboard — Daily Motivation floating popup (minutes, integers 1–120).
# Visible: how long the card stays on screen before auto-hiding. Hidden: wait before showing again (tab must be visible).
# Full cycle = visible + hidden (used when user switches back to the tab). Defaults: 10 visible, 1 hidden.
# VITE_POPUP_CARD_VISIBLE_MINUTES=10
# VITE_POPUP_CARD_HIDDEN_MINUTES=1
VITE_POPUP_CARD_VISIBLE_MINUTES=10
VITE_POPUP_CARD_HIDDEN_MINUTES=1