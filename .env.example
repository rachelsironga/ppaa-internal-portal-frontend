# API base URL the *browser* uses (must be reachable from the machine opening the SPA).

# Local Vite (http://localhost:3000): prefer same-host API to avoid Chrome "Private Network Access"
# blocking localhost → 192.168.x.x unless the backend sets CORS_ALLOW_PRIVATE_NETWORK (we do in Django).
# VITE_API_URL=http://localhost:8092

# LAN / testing from another PC: use the server's IP.
# VITE_API_URL=http://192.168.1.4:8092

# Trailing slash optional; stripped at runtime. Match nginx API port (e.g. 8092), not Vite (3000).
